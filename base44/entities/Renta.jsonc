{
  "name": "Renta",
  "type": "object",
  "properties": {
    "ip": {
      "type": "string",
      "description": "Direcci\u00f3n IP de la renta"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "whatsapp": {
      "type": "string",
      "description": "N\u00famero de WhatsApp del cliente"
    },
    "tiempo_renta": {
      "type": "number",
      "description": "Tiempo de renta en d\u00edas (1-30)"
    }
  },
  "required": [
    "ip",
    "nombre",
    "whatsapp",
    "tiempo_renta"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}